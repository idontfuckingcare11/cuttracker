{
  "name": "cuttrack",
  "private": true,
  "version": "1.0.0",
  "description": "CutTrack - full-stack fitness & calorie deficit tracker",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "start": "node server/src/index.js",
    "start:server": "npm run start -w server",
    "build": "npm run build -w client",
    "test": "npm run test -w server",
    "seed": "npm run seed -w server",
    "db:migrate": "npm run db:migrate -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
