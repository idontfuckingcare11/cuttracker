# ============ CutTrack environment template ============
# Copy this file to server/.env and fill in your values.
# Never commit the real .env file.

# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Storage ---
# memory   = built-in in-memory store (no database required, great for dev/demo)
# supabase = Supabase PostgreSQL via Prisma (recommended)
# mysql    = MySQL via Prisma
STORAGE_ENGINE=memory

# Optional: persist the in-memory store to a JSON file between restarts
# DATA_FILE=C:\Portfolio\CutTracker\data\cuttrack.json

# --- Supabase PostgreSQL (used when STORAGE_ENGINE=supabase) ---
# Replace YOUR_PASSWORD with your Supabase DB password (Supabase Dashboard -> Project Settings -> Database)
DATABASE_URL="postgres://postgres.hnptnbxhrwsvvhqxfoak:[YOUR_PASSWORD]@db.hnptnbxhrwsvvhqxfoak.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres:[YOUR_PASSWORD]@db.hnptnbxhrwsvvhqxfoak.supabase.co:5432/postgres"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-in-production
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# --- AI (Groq) ---
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Password reset email (optional; without SMTP the reset link is logged to console in dev) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CutTrack <no-reply@cuttrack.app>
